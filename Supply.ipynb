import os
import pandas as pd
import numpy as np

final_df = []
df = []
folder_name = '10T'

demand_map = {}
del_map = {}
lat_map = {}
lon_map = {}

for foldername_sub in os.listdir(folder_name):
   
    foldervar = foldername_sub
    parts = foldervar.split('_')
    
   
    try:
        station_count = int(parts[6].replace('stations', ''))
    except:
        station_count = 0

    file_path = os.path.join(folder_name, foldervar, 'outputs')
    file2_path = os.path.join(folder_name, foldervar, 'inputs', 'data')

    # --- STEP 1: FIND TOTAL COSTS ---
    total_val_carbon = 0; total_val_electrolysis = 0; total_val_any = 0
    for filename in os.listdir(file_path):
        full_path = os.path.join(file_path, filename)
        if 'system' in filename:
            cost_df = pd.read_csv(full_path)
            val = cost_df['cost_usdPerDay'].iloc[3]
            if 'low_carbon' in filename: total_val_carbon = val
            elif 'elec' in filename: total_val_electrolysis = val
            else: total_val_any = val

  
    dist_list = []
    for filename in os.listdir(file_path):
        if 'distribution' in filename:
            dist_df = pd.read_csv(os.path.join(file_path, filename))
            dist_df['StationID'] = dist_df['arc_start'].str.split('_').str[0].astype(str).str.strip()
            dist_df['Mode'] = np.where(dist_df['dist_km'] == 0, 'Onsite', 'Pipeline')
            dist_list.append(dist_df[['StationID', 'Mode']])
    
  
    if dist_list:
        current_scenario_modes = pd.concat(dist_list).drop_duplicates()
    else:
        current_scenario_modes = pd.DataFrame(columns=['StationID', 'Mode'])

   
    for filename in os.listdir(file_path):
        full_path = os.path.join(file_path, filename)
        if 'consumption' in filename:
            cons_df = pd.read_csv(full_path)
            cons_df['StationID'] = cons_df['consumer'].str.split('_').str[0].astype(str).str.strip()
            demand_map.update(dict(zip(cons_df.StationID, cons_df.cons_h)))
        if 'delivered' in filename:
            del_df = pd.read_csv(full_path)
            del_df['StationID'] = del_df['site_id'].astype(str).str.strip()
            del_map.update(dict(zip(del_df.StationID, del_df.min_delivered_price)))

    for filename in os.listdir(file2_path):
        if 'hubs' in filename:
            hubs_df = pd.read_csv(os.path.join(file2_path, filename))
            lat_map.update(dict(zip(hubs_df['hub'].astype(str), hubs_df['latitude'])))
            lon_map.update(dict(zip(hubs_df['hub'].astype(str), hubs_df['longitude'])))

  
    for filename in os.listdir(file_path):
        if 'production' in filename:
            temp_df = pd.read_csv(os.path.join(file_path, filename))
            
            
            if 'low_carbon' in filename:
                current_type = 'low_carbon'; total_cost = total_val_carbon
            elif 'elec' in filename:
                current_type = 'electrolysis'; total_cost = total_val_electrolysis
            else:
                current_type = 'any'; total_cost = total_val_any

           
            temp_df['StationID'] = temp_df['producer'].str.split('_').str[0].astype(str).str.strip()
            
           
            if 'Mode' in temp_df.columns: temp_df.drop(columns=['Mode'], inplace=True)
            temp_df = temp_df.merge(current_scenario_modes, on='StationID', how='left')

           
            temp_df['Constraint'] = current_type
            temp_df['Scenario_TotalCost_perDay'] = total_cost
            temp_df['ScenarioID'] = foldervar
            temp_df['StationCount'] = station_count
            temp_df['Production_Type'] = temp_df['producer'].str.split('_').str[2]
            temp_df['ProductionCost_perDay'] = temp_df['total_cost']
            temp_df['ProductionCapacity_tpd'] = temp_df['prod_capacity']
            temp_df['CO2_Emitted_tpd'] = temp_df['co2_emitted']
            temp_df['CO2_Captured_tpd'] = temp_df['co2_captured']

           
            temp_df['demand_tpd'] = temp_df['StationID'].map(demand_map)
            temp_df['DeliveredCost_usd_per_kg'] = temp_df['StationID'].map(del_map)
            temp_df['Latitude'] = temp_df['StationID'].map(lat_map)
            temp_df['Longitude'] = temp_df['StationID'].map(lon_map)

            temp_df['Value1'] = temp_df['DeliveredCost_usd_per_kg']/1000
            temp_df['Estimated_dispensed_cost'] = temp_df.apply(
                lambda row: f"${row['Value1'] + 1:.2f} - ${row['Value1'] + 4:.2f}/kg" 
                if pd.notnull(row['Value1']) else "", 
                axis=1
            )

           
            target_cols = [
                'Latitude', 'Longitude', 'StationID', 'demand_tpd',
                'Production_Type', 'ProductionCapacity_tpd', 'ProductionCost_perDay',
                'CO2_Emitted_tpd', 'CO2_Captured_tpd', 'DeliveredCost_usd_per_kg',
                'Mode', 'Scenario_TotalCost_perDay', 'ScenarioID', 'StationCount', 'Constraint','Estimated_dispensed_cost'
            ]
            temp_df = temp_df.reindex(columns=target_cols)
            df.append(temp_df)


Concat_df = pd.concat(df, ignore_index=True)
Concat_df.to_csv('Stations_GTI.csv', index=False)
